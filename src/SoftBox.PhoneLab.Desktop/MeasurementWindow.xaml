<Window x:Class="SoftBox.PhoneLab.Desktop.MeasurementWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PhoneLab — External Measurement Rig" Width="760" Height="780"
 WindowStartupLocation="CenterOwner" Background="#081321" Foreground="#EAF3FF"
 FontFamily="Segoe UI">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="USB / SERIAL MEASUREMENT ENGINE" Foreground="#6DD2FF" FontWeight="Bold" FontSize="11"/>
   <TextBlock Text="أجهزة القياس الخارجية" FontSize="23" FontWeight="Bold" Margin="0,5,0,0"/>
   <TextBlock Text="قراءة سلبية فقط من جهاز قياس متوافق مع PhoneLab JSON-Lines v1." Foreground="#8EA8C4" FontSize="11" Margin="0,6,0,12"/>
  </StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,14">
   <ComboBox x:Name="Ports" Width="150" Height="32" Background="#14263C" Foreground="#EAF3FF" Margin="0,0,8,0"/>
   <Button Content="تحديث المنافذ" Click="RefreshPorts_Click" Margin="0,0,8,0"/>
   <Button x:Name="ConnectButton" Content="اتصال" Click="Connect_Click" Background="#075F94" BorderBrush="#168BCB"/>
   <Button Content="تحميل حدود القياس JSON" Click="LoadProfile_Click" Margin="8,0,0,0"/>
  </DockPanel>
  <Border Grid.Row="2" Background="#101E30" BorderBrush="#29415C" BorderThickness="1" CornerRadius="13" Padding="15">
   <StackPanel>
    <TextBlock x:Name="InstrumentName" Text="لا يوجد جهاز قياس متصل" FontSize="15" FontWeight="Bold"/>
    <TextBlock x:Name="StatusText" Text="اختر منفذ COM، ثم اتصل بجهاز قياس مدعوم." Foreground="#91A8C3" FontSize="10" Margin="0,5,0,16"/>
    <UniformGrid Columns="2">
     <StackPanel Margin="0,0,8,12"><TextBlock Text="USB INPUT" Foreground="#7794B2" FontSize="9"/><TextBlock x:Name="UsbVoltage" Text="— V" FontSize="26" FontWeight="Bold"/></StackPanel>
     <StackPanel Margin="0,0,0,12"><TextBlock Text="BATTERY VOLTAGE" Foreground="#7794B2" FontSize="9"/><TextBlock x:Name="BatteryVoltage" Text="— V" FontSize="26" FontWeight="Bold"/></StackPanel>
     <StackPanel Margin="0,0,8,12"><TextBlock Text="BATTERY CURRENT" Foreground="#7794B2" FontSize="9"/><TextBlock x:Name="BatteryCurrent" Text="— A" FontSize="26" FontWeight="Bold"/></StackPanel>
     <StackPanel Margin="0,0,0,12"><TextBlock Text="BOARD TEMPERATURE" Foreground="#7794B2" FontSize="9"/><TextBlock x:Name="BoardTemperature" Text="— °C" FontSize="26" FontWeight="Bold"/></StackPanel>
     <StackPanel Margin="0,0,8,12"><TextBlock Text="BATTERY CAPACITY" Foreground="#7794B2" FontSize="9"/><TextBlock x:Name="BatteryCapacity" Text="— mAh" FontSize="22" FontWeight="Bold"/></StackPanel>
     <StackPanel Margin="0,0,0,12"><TextBlock Text="BATTERY INTERNAL RESISTANCE" Foreground="#7794B2" FontSize="9"/><TextBlock x:Name="BatteryResistance" Text="— mΩ" FontSize="22" FontWeight="Bold"/></StackPanel>
    </UniformGrid>
    <Border Height="1" Background="#29415C" Margin="0,2,0,2"/>
    <TextBlock Text="Power / Rail measurements" Foreground="#91A8C3" FontWeight="Bold" FontSize="11" Margin="0,12,0,8"/>
    <TextBlock x:Name="PowerValue" Text="USB Power: —" FontSize="11" Margin="0,0,0,7"/>
    <TextBlock x:Name="RailsValue" Text="لم تصل قراءات خطوط الطاقة بعد." FontSize="10" Foreground="#A8BCD1" TextWrapping="Wrap"/>
    <TextBlock x:Name="ReferenceStatus" Text="لم يتم تحميل ملف حدود مرجعية." FontSize="10" Foreground="#F2C27C" TextWrapping="Wrap" Margin="0,8,0,0"/>
   </StackPanel>
  </Border>
  <Border Grid.Row="3" Background="#101E30" BorderBrush="#29415C" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,12,0,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
     <TextBlock Text="سجل القياسات" FontWeight="Bold" VerticalAlignment="Center"/>
     <Button Content="تصدير CSV" Click="ExportCsv_Click" Margin="10,0,0,0" Padding="12,4"/>
    </StackPanel>
    <ListBox x:Name="SampleLog" Background="#0B1725" Foreground="#D4E4F4" BorderBrush="#293E56" FontSize="9"/>
   </DockPanel>
  </Border>
  <TextBlock Grid.Row="4" Text="حدود المقارنة تُحمّل من ملف فني موثق يختاره المستخدم ولا تمثل مواصفات مصنع تلقائية. لا توصل مجسات أو مصادر طاقة عشوائية بالهاتف؛ يلزم جهاز قياس معزول ولا يحقن البرنامج أي فولتية." Foreground="#F2C27C" FontSize="10" TextWrapping="Wrap" Margin="2,13,2,0"/>
 </Grid>
</Window>
