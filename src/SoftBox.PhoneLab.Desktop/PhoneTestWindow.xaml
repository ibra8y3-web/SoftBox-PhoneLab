<Window x:Class="SoftBox.PhoneLab.Desktop.PhoneTestWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SoftBox PhoneLab — اختبارات الهاتف المباشرة"
 Width="790" Height="760" MinWidth="660" MinHeight="620"
 WindowStartupLocation="CenterOwner" Background="#081321" Foreground="#EAF3FF"
 FlowDirection="RightToLeft" FontFamily="Segoe UI">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="USB AGENT • REMOTE TEST CONTROL" Foreground="#68D3FF" FontSize="10" FontWeight="Bold"/>
   <TextBlock Text="لوحة الاختبارات المباشرة" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
   <TextBlock x:Name="DeviceTitle" Text="الهاتف المتصل" FontSize="11" Foreground="#91A9C4" Margin="0,6,0,12"/>
  </StackPanel>
  <Border Grid.Row="1" Background="#10243A" BorderBrush="#2A4763" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="تشغيل الاختبارات من الكمبيوتر" FontWeight="Bold" FontSize="12"/>
    <UniformGrid Columns="3" Margin="0,10,0,0">
     <Button Tag="display" Content="ألوان الشاشة" Click="RunTest_Click" Margin="3"/>
     <Button Tag="touch" Content="تغطية اللمس" Click="RunTest_Click" Margin="3"/>
     <Button Tag="camera" Content="كل الكاميرات والتركيز" Click="RunTest_Click" Margin="3"/>
     <Button Tag="speaker" Content="السماعة الخارجية" Click="RunTest_Click" Margin="3"/>
     <Button Tag="earpiece" Content="سماعة المكالمات" Click="RunTest_Click" Margin="3"/>
     <Button Tag="microphone" Content="الميكروفون" Click="RunTest_Click" Margin="3"/>
     <Button Tag="flashlight" Content="فلاش الكاميرا" Click="RunTest_Click" Margin="3"/>
     <Button Tag="vibration" Content="الاهتزاز" Click="RunTest_Click" Margin="3"/>
     <Button Tag="sensors" Content="المستشعرات الحية" Click="RunTest_Click" Margin="3"/>
     <Button Tag="hardware" Content="جرد المكونات المدعومة" Click="RunTest_Click" Margin="3"/>
     <Button Tag="battery_capacity_start" Content="بدء رصد البطارية" Click="RunTest_Click" Margin="3"/>
     <Button Tag="battery_capacity_finish" Content="حساب تقدير البطارية" Click="RunTest_Click" Margin="3"/>
    </UniformGrid>
   </StackPanel>
  </Border>
  <Border Grid.Row="2" Background="#101E30" BorderBrush="#29415C" BorderThickness="1" CornerRadius="12" Padding="13">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="النتائج المتزامنة من الهاتف" FontSize="14" FontWeight="Bold"/>
     <TextBlock x:Name="SyncStatus" Text="جارٍ انتظار Agent..." FontSize="10" Foreground="#91A8C3" Margin="0,5,0,10"/>
    </StackPanel>
    <ListBox x:Name="ResultsList" Background="#0B1827" BorderBrush="#263D55" Foreground="#D9E7F6"
             FontSize="10" Padding="8"/>
   </DockPanel>
  </Border>
  <DockPanel Grid.Row="3" Margin="0,12,0,0">
   <TextBlock Text="الاختبار يُنفذ على الهاتف عبر ADB المحلي. أبقِ Agent مفتوحًا وغير مقيد من Android." Foreground="#D8B779" FontSize="9" VerticalAlignment="Center"/>
   <Button DockPanel.Dock="Left" Content="تحديث الآن" Click="Refresh_Click" Margin="8,0,0,0"/>
  </DockPanel>
 </Grid>
</Window>
