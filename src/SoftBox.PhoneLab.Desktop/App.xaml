<Application x:Class="SoftBox.PhoneLab.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="CanvasBrush" Color="#080F1D"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#101D30"/>
  <SolidColorBrush x:Key="PanelAltBrush" Color="#14243A"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#253A55"/>
  <SolidColorBrush x:Key="TextBrush" Color="#ECF4FF"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#8CA3BF"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Background" Value="#172D48"/>
   <Setter Property="BorderBrush" Value="#2C4967"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,9"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#204363"/><Setter TargetName="surface" Property="BorderBrush" Value="#2CA8DD"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ListBox">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Background" Value="#0B1728"/>
   <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
   <Setter Property="Padding" Value="9,7"/>
  </Style>
 </Application.Resources>
</Application>
