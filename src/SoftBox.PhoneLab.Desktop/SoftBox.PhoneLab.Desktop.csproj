<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>SoftBox.PhoneLab.Desktop</RootNamespace>
    <AssemblyName>SoftBox-PhoneLab</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>SoftBox</Authors>
    <Description>Intelligent smartphone diagnostics workstation</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SoftBox.PhoneLab.Core\SoftBox.PhoneLab.Core.csproj" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <Content Include="..\..\data\boardmaps\**\*.json" Link="Data\boardmaps\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\device-profiles\**\*.json" Link="Data\device-profiles\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../SoftBox.PluginHost/SoftBox.PluginHost.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
  </ItemGroup>
</Project>
