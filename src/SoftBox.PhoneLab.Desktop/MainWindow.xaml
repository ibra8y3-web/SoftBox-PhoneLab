<Window x:Class="SoftBox.PhoneLab.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:interop="clr-namespace:SoftBox.PhoneLab.Desktop.Interop"
 Title="SoftBox | Universal Smart Device Service &amp; Repair Platform"
 Icon="pack://application:,,,/Assets/SoftBox-AppIcon.ico"
 Width="1440" Height="900" MinWidth="900" MinHeight="560"
 ResizeMode="CanResize"
 WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}"
 Foreground="{StaticResource TextBrush}" FlowDirection="RightToLeft"
 FontFamily="Segoe UI Variable Text, Segoe UI">
 <Grid x:Name="MainLayoutRoot" Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>

  <Border Grid.Row="0" Background="#0F1E32" BorderBrush="#263D58" BorderThickness="1" CornerRadius="15" Padding="16,10">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="46" Height="46" Background="#0D3958" BorderBrush="#177EB4" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
      <Image Source="pack://application:,,,/Assets/SoftBox-AppIcon.ico" Width="42" Height="42" Stretch="Uniform"/>
     </Border>
     <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
      <TextBlock Text="SoftBox" FontSize="21" FontWeight="Bold"/>
      <TextBlock Text="UNIVERSAL SMART DEVICE SERVICE &amp; REPAIR PLATFORM" FontSize="8.5" Foreground="#7996B5" Margin="0,3,0,0"/>
     </StackPanel>
     <Border Background="#132E46" BorderBrush="#245675" BorderThickness="1" CornerRadius="10" Padding="11,6" Margin="18,0,0,0" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal">
       <Ellipse Width="7" Height="7" Fill="#38BDF8" Margin="0,0,7,0" VerticalAlignment="Center"/>
       <TextBlock Text="{Binding EngineStatus}" FontSize="10" Foreground="#BDEAFF" VerticalAlignment="Center"/>
      </StackPanel>
     </Border>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
      <TextBlock Text="حجم الواجهة" FontSize="9" Foreground="#8199B5" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <Button Content="−" Click="DecreaseUiScale_Click" MinWidth="30" Padding="5,5" ToolTip="تصغير الواجهة"/>
      <TextBlock x:Name="UiScaleLabel" Text="100%" FontSize="9" Foreground="#C7E7FF" VerticalAlignment="Center" Margin="6,0"/>
      <Button Content="+" Click="IncreaseUiScale_Click" MinWidth="30" Padding="5,5" ToolTip="تكبير الواجهة"/>
     </StackPanel>
     <Button Content="{Binding LanguageToggleText}" Click="ToggleLanguage_Click"
      MinWidth="78" Padding="10,8" Margin="0,0,12,0" ToolTip="تبديل العربية والإنجليزية"/>
     <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
      <TextBlock Text="المستخدم الحالي" FontSize="9" Foreground="#8199B5" HorizontalAlignment="Right"/>
      <TextBlock Text="{Binding CurrentUserDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#C7E7FF" HorizontalAlignment="Right"/>
     </StackPanel>
     <Button Content="قفل الجلسة" Click="LockSession_Click" MinWidth="105" Padding="12,8" Background="#6B3D22"/>
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Row="1" Margin="0,14,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.0*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="2.15*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>

   <!-- Master navigation: 36 modules in the same order as the SoftBox specification. -->
   <Border Grid.Column="0" Background="#0D1C2E" BorderBrush="#263D58" BorderThickness="1" CornerRadius="14" Padding="10" Margin="0,0,12,0">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="أقسام SoftBox" FontSize="18" FontWeight="Bold" Foreground="#7DD3FC"/>
      <TextBlock Text="36 قسمًا • كل قسم يفتح داخل نفس الواجهة" FontSize="9" Foreground="#8199B5" Margin="0,4,0,9"/>
      <TextBlock Text="اختر قسمًا لعرض أدواته وحالة تنفيذها" FontSize="9" Foreground="#9CB3CC" TextWrapping="Wrap" Margin="0,0,0,7"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <TextBlock Text="01–03 | الرئيسية والأجهزة" Foreground="#6EA7CC" FontWeight="Bold" FontSize="10" Margin="4,9,4,4"/>
       <Button Content="01  لوحة التحكم — Dashboard" Tag="dashboard" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="02  مركز الأجهزة — Device Center" Tag="device-center" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="03  ذكاء الأجهزة — Device Intelligence" Tag="device-intelligence" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>

       <TextBlock Text="04–05 | Android والتطبيقات" Foreground="#6EA7CC" FontWeight="Bold" FontSize="10" Margin="4,13,4,4"/>
       <Button Content="04  مركز صيانة Android" Tag="android-service" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="05  مختبر APK — APK Lab" Tag="apk-lab" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>

       <TextBlock Text="06–10 | الشركات والمعالجات" Foreground="#6EA7CC" FontWeight="Bold" FontSize="10" Margin="4,13,4,4"/>
       <Button Content="06  أدوات Samsung" Tag="samsung-tools" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="07  أدوات Xiaomi / Redmi / POCO" Tag="xiaomi-tools" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="08  شركات Android الأخرى" Tag="android-brands" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="09  أدوات Qualcomm" Tag="qualcomm-tools" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="10  أدوات MediaTek" Tag="mediatek-tools" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>

       <TextBlock Text="11–14 | Firmware والاتصال والنسخ" Foreground="#6EA7CC" FontWeight="Bold" FontSize="10" Margin="4,13,4,4"/>
       <Button Content="11  مركز Firmware" Tag="firmware-center" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="12  طبيب USB — USB Doctor" Tag="usb-doctor" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="13  النسخ الاحتياطي الذكي" Tag="smart-backup" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="14  استوديو الهاتف — Phone Link" Tag="phone-link" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>

       <TextBlock Text="15–19 | الفحص والذكاء والاستعادة" Foreground="#6EA7CC" FontWeight="Bold" FontSize="10" Margin="4,13,4,4"/>
       <Button Content="15  تشخيص العتاد" Tag="hardware-diagnostics" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="16  تشخيص الشبكات" Tag="network-diagnostics" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="17  مساعد الإصلاح الذكي" Tag="smart-repair-ai" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="18  الفحص الشامل بزر واحد" Tag="one-click-diagnostic" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="19  الاستعادة الآمنة" Tag="safe-recovery" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>

       <TextBlock Text="20–25 | الأتمتة وإدارة الصيانة" Foreground="#6EA7CC" FontWeight="Bold" FontSize="10" Margin="4,13,4,4"/>
       <Button Content="20  أتمتة سير العمل" Tag="workflow-automation" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="21  العمليات الجماعية" Tag="batch-operations" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="22  سجل الصيانة" Tag="repair-history" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="23  إدارة مركز الصيانة" Tag="workshop-manager" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="24  مخزون قطع الغيار" Tag="parts-inventory" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="25  تقارير الخدمة" Tag="service-reports" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>

       <TextBlock Text="26–28 | الإضافات والعمل دون إنترنت" Foreground="#6EA7CC" FontWeight="Bold" FontSize="10" Margin="4,13,4,4"/>
       <Button Content="26  متجر الإضافات" Tag="plugin-store" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="27  Plugin SDK للمطورين" Tag="plugin-sdk" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="28  مركز Offline" Tag="offline-center" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>

       <TextBlock Text="29–36 | النظام والحماية والدعم" Foreground="#6EA7CC" FontWeight="Bold" FontSize="10" Margin="4,13,4,4"/>
       <Button Content="29  الأمان والخصوصية" Tag="security-privacy" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="30  المستخدمون والفنيون" Tag="user-technician-management" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="31  مركز التحديثات" Tag="update-center" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="32  مركز الإشعارات" Tag="notification-center" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="33  مركز المساعدة" Tag="help-center" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="34  الدعم والسجلات" Tag="support-logs" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="35  الإعدادات" Tag="settings" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
       <Button Content="36  حول SoftBox" Tag="about" Click="ModuleNavigation_Click" Margin="2" Padding="7,6" FontSize="10" HorizontalContentAlignment="Stretch"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>

      <!-- Discovery and component tree -->
   <Grid x:Name="DevicesColumn" Grid.Column="1" Margin="0,0,12,0">
    <Grid.RowDefinitions><RowDefinition Height="0.8*"/><RowDefinition Height="1.2*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="13" Margin="0,0,0,10">
     <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Top">
       <TextBlock Text="الأجهزة المتصلة" FontSize="15" FontWeight="Bold"/>
       <TextBlock Text="USB / ADB • اكتشاف دوري" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10"/>
      </StackPanel>
      <Button DockPanel.Dock="Top" Content="تثبيت ADB تلقائيًا (مطلوب لاكتشاف الهاتف)" Click="InstallAdb_Click"
       Visibility="{Binding AdbInstallVisibility}" Background="#0F5C8A" Margin="0,0,0,10" Padding="8,8" FontSize="10"/>
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding DiscoveryHint}" FontSize="9" Foreground="#8199B5" TextWrapping="Wrap" Margin="2,8,2,0"/>
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding UsbRecognitionStatus}" FontSize="9" Foreground="#70C8E8" TextWrapping="Wrap" MaxHeight="42" Margin="2,8,2,0"/>
      <ListBox x:Name="DevicesList" ItemsSource="{Binding Devices}" SelectionChanged="Devices_SelectionChanged">
       <ListBox.ItemTemplate>
        <DataTemplate>
         <Border Background="#132238" BorderBrush="#263E58" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,2">
          <StackPanel>
           <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="SemiBold" Foreground="#EAF4FF" TextWrapping="Wrap"/>
           <TextBlock Text="{Binding MaskedSerial}" FontSize="9" Foreground="#8299B4" Margin="0,4,0,0"/>
           <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Ellipse Width="6" Height="6" Fill="{Binding StateBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StateText}" FontSize="9" Foreground="{Binding StateBrush}" Margin="6,0,0,0"/>
           </StackPanel>
          </StackPanel>
         </Border>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
    </Border>

    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="13">
     <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Top">
       <TextBlock Text="مكونات الهاتف" FontSize="15" FontWeight="Bold"/>
       <TextBlock Text="اختر القطعة لرؤية الأدلة" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,9"/>
      </StackPanel>
      <ListBox x:Name="ComponentsList" ItemsSource="{Binding Components}" SelectionChanged="Components_SelectionChanged">
       <ListBox.ItemTemplate>
        <DataTemplate>
         <Grid Margin="2,3">
          <Grid.ColumnDefinitions><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="5" Background="{Binding StatusBrush}" CornerRadius="3" Margin="0,1"/>
          <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="10" Foreground="#DDE9F8" VerticalAlignment="Center" Margin="7,0,3,0"/>
          <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" FontSize="8" Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
         </Grid>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
    </Border>
   </Grid>

   <!-- 3D exploded view -->
   <Grid x:Name="ViewerColumn" Grid.Column="2" Margin="0,0,12,0">
    <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="82"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#10243B" BorderBrush="#284C6A" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,0,11">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="{Binding DeviceTitle}" FontSize="18" FontWeight="Bold"/>
       <TextBlock Text="{Binding DeviceSubtitle}" FontSize="9.5" Foreground="#8EABC8" Margin="0,5,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" Background="#142E46" BorderBrush="#2D607C" BorderThickness="1" CornerRadius="9" Padding="12,7" VerticalAlignment="Center">
       <TextBlock Text="{Binding ScanStatus}" Foreground="#9DDEFB" FontSize="9.5" FontWeight="SemiBold"/>
      </Border>
     </Grid>
    </Border>
    <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Background="#091321" BorderBrush="#203751" BorderThickness="1">
     <TabItem Header="المجسم ثلاثي الأبعاد">
<Border Grid.Row="1" Background="#091321" BorderBrush="#203751" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
     <Grid>
      <Viewport3D x:Name="PhoneViewport" ClipToBounds="True"
       MouseDown="Viewport_MouseDown" MouseLeftButtonDown="Viewport_DoubleClick" MouseMove="Viewport_MouseMove" MouseUp="Viewport_MouseUp" MouseWheel="Viewport_MouseWheel"/>
      <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="13" Background="#CC111F33" BorderBrush="#2A425D" BorderThickness="1" CornerRadius="9" Padding="10,7">
       <StackPanel>
        <DockPanel>
         <TextBlock Text="التفكيك" FontSize="9" Foreground="#9CB3CC" VerticalAlignment="Center" Margin="0,0,8,0"/>
         <Slider x:Name="ExplodeSlider" Minimum="0" Maximum="100" Value="80" Width="130" VerticalAlignment="Center" ValueChanged="Explode_Changed"/>
        </DockPanel>
        <CheckBox x:Name="DisplayLayerCheck" Content="إظهار طبقة الشاشة" IsChecked="True" FontSize="9" Foreground="#C3D3E7" Margin="0,7,0,0" Checked="DisplayLayer_Changed" Unchecked="DisplayLayer_Changed"/>
        <Button Content="إعادة ضبط العرض" Click="ResetView_Click" FontSize="9" Padding="8,4" Margin="0,7,0,0"/>
       </StackPanel>
      </Border>
      <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15" IsHitTestVisible="False">
       <TextBlock Text="EXPLODED SMARTPHONE ASSEMBLY" FontSize="9" FontWeight="Bold" Foreground="#66CFF8"/>
       <TextBlock Text="اسحب للتدوير • عجلة الماوس للتكبير • اختر القطعة" FontSize="9" Foreground="#7794B4" Margin="0,4,0,0"/>
      </StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Background="#3A2B19" BorderBrush="#94692F" BorderThickness="1" CornerRadius="8" Padding="9,6" IsHitTestVisible="False">
       <TextBlock Text="{Binding BoardMapNotice}" FontSize="8.5" Foreground="#FFDA9C" TextWrapping="Wrap" MaxWidth="260"/>
      </Border>
      <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="13" Background="#111F33" BorderBrush="#2A425D" BorderThickness="1" CornerRadius="8" Padding="9,5" IsHitTestVisible="False">
       <TextBlock Text="3D SCHEMATIC • MODEL-AWARE MAP ENGINE" FontSize="8" Foreground="#84A2C1"/>
      </Border>
     </Grid>
    </Border>
         </TabItem>
     <TabItem Header="شاشة الهاتف الحقيقية">
      <Border Background="#050B13" ClipToBounds="True">
       <Grid>
        <interop:ScrcpyWindowHost x:Name="PhoneScreenHost"/>
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Background="#14263A" BorderBrush="#31516C" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="8" IsHitTestVisible="False">
         <TextBlock Text="{Binding MirrorStatus}" Foreground="#D4E8FA" FontSize="10" TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center"/>
        </Border>
       </Grid>
      </Border>
     </TabItem>
    </TabControl>
<Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="11" Margin="0,11,0,0">
     <StackPanel>
      <TextBlock Text="دليل الألوان" FontSize="9" Foreground="#839AB5" FontWeight="Bold" Margin="0,0,0,8"/>
      <UniformGrid Columns="5">
       <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,5,0"/><TextBlock Text="ناجح" FontSize="9" Foreground="#C3D3E7"/></StackPanel>
       <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,5,0"/><TextBlock Text="مراجعة" FontSize="9" Foreground="#C3D3E7"/></StackPanel>
       <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#EF4444" Margin="0,0,5,0"/><TextBlock Text="فشل" FontSize="9" Foreground="#C3D3E7"/></StackPanel>
       <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#38BDF8" Margin="0,0,5,0"/><TextBlock Text="مقروء" FontSize="9" Foreground="#C3D3E7"/></StackPanel>
       <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#64748B" Margin="0,0,5,0"/><TextBlock Text="لم يختبر" FontSize="9" Foreground="#C3D3E7"/></StackPanel>
      </UniformGrid>
     </StackPanel>
    </Border>
   </Grid>

   <!-- Device properties and selected part detail -->
   <ScrollViewer x:Name="DetailsColumn" Grid.Column="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,11">
      <StackPanel>
       <TextBlock Text="هوية الهاتف ومواصفاته" FontSize="15" FontWeight="Bold"/>
       <TextBlock Text="قراءات النظام المتاحة عبر Android" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10"/>
       <ItemsControl ItemsSource="{Binding DeviceFacts}">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Grid Margin="0,5">
           <Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <TextBlock Text="{Binding Label}" FontSize="9" Foreground="#849DB9"/>
           <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="9.5" Foreground="#E1ECF9" TextWrapping="Wrap"/>
          </Grid>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </Border>

     <Border Background="#11243A" BorderBrush="#2D4A68" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,11">
      <StackPanel>
       <TextBlock Text="{Binding SelectedPartName}" FontSize="14" FontWeight="Bold"/>
       <TextBlock Text="{Binding SelectedPartStatus}" FontSize="10" Foreground="{Binding SelectedPartBrush}" FontWeight="SemiBold" Margin="0,5,0,0"/>
       <TextBlock Text="{Binding SelectedPartDescription}" FontSize="10" Foreground="#B6C9DE" TextWrapping="Wrap" Margin="0,9,0,0"/>
       <TextBlock Text="{Binding SelectedPartEvidence}" FontSize="9" Foreground="#83A1BF" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>

     <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
      <StackPanel>
       <TextBlock Text="PhoneLab Agent" FontSize="14" FontWeight="Bold"/>
       <TextBlock Text="{Binding AgentStatus}" FontSize="9.5" Foreground="#90A8C3" TextWrapping="Wrap" Margin="0,6,0,10"/>
       <Button Content="فتح تعليمات تطبيق الهاتف" Click="AgentHelp_Click" HorizontalAlignment="Stretch"/>
       <TextBlock Text="اختبارات Agent: الشاشة واللمس والكاميرا والصوت والاهتزاز والحساسات وBluetooth وWi-Fi وNFC وGPS والبصمة والأزرار وSIM. يتضمن رصد البطارية المجدول وسجلات JSONL والتقاط الأعطال وتصدير تقرير محلي." FontSize="9" Foreground="#7D94AE" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>

   <!-- Embedded pages: every section and tool opens here, inside the same workspace. -->
   <Border x:Name="EmbeddedHostPanel" Grid.Column="1" Grid.ColumnSpan="3" Visibility="Collapsed"
    Background="#081321" BorderBrush="#263D58" BorderThickness="1" CornerRadius="14">
    <DockPanel LastChildFill="True">
     <Border DockPanel.Dock="Top" Background="#0F1E32" BorderBrush="#263D58" BorderThickness="0,0,0,1" CornerRadius="14,14,0,0" Padding="10,7">
      <StackPanel Orientation="Horizontal">
       <Button Content="→ رجوع" Click="EmbeddedBack_Click" Padding="14,6" Margin="0,0,8,0"/>
       <Button Content="⌂ الرئيسية" Click="EmbeddedHome_Click" Padding="14,6" Margin="0,0,14,0"/>
       <TextBlock x:Name="EmbeddedTitle" FontSize="14" FontWeight="Bold" Foreground="#7DD3FC" VerticalAlignment="Center"/>
      </StackPanel>
     </Border>
     <Border x:Name="EmbeddedBody" Padding="6"/>
    </DockPanel>
   </Border>
  </Grid>

  <Border Grid.Row="2" Background="#0D192A" BorderBrush="#1E324A" BorderThickness="1" CornerRadius="8" Padding="10,5">
   <DockPanel>
    <TextBlock Text="{Binding StatusMessage}" FontSize="9" Foreground="#A7BBD2" VerticalAlignment="Center"/>
    <TextBlock DockPanel.Dock="Right" Text="SOFTBOX • PHONE DIAGNOSTICS" FontSize="8" Foreground="#667F9D" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
