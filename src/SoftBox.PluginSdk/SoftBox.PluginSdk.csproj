<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SoftBox.PluginSdk</AssemblyName>
    <RootNamespace>SoftBox.PluginSdk</RootNamespace>
    <Version>1.0.0</Version>
    <PackageId>SoftBox.PluginSdk</PackageId>
    <Authors>SoftBox</Authors>
    <Description>Public manifest and package-authoring contracts for SoftBox PhoneLab plugins.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
