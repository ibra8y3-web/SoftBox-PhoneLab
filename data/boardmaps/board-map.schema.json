{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softbox.invalid/schemas/board-map-v1.schema.json",
  "title": "SoftBox model-specific board map v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "manufacturer",
    "model",
    "boardRevision",
    "dimensions",
    "sources",
    "components",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profileId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "manufacturer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Exact commercial model, not only the chipset or codename."
    },
    "regionalVariants": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80
      },
      "maxItems": 50,
      "uniqueItems": true
    },
    "codename": {
      "type": "string",
      "maxLength": 100
    },
    "boardRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "unit",
        "origin"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "unit": {
          "enum": [
            "mm",
            "px"
          ]
        },
        "origin": {
          "const": "top-left"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "publisher",
          "reference",
          "obtainedAt",
          "rightsNote"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,80}$"
          },
          "kind": {
            "enum": [
              "manufacturer-document",
              "licensed-schematic",
              "licensed-boardview",
              "teardown",
              "physical-inspection",
              "technician-measurement",
              "other"
            ]
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "obtainedAt": {
            "type": "string",
            "format": "date"
          },
          "rightsNote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "components": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "label",
          "x",
          "y",
          "confidence",
          "sourceIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "category": {
            "enum": [
              "ic",
              "connector",
              "flex",
              "shield",
              "test-point",
              "passive",
              "camera",
              "display",
              "battery",
              "other"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 160
          },
          "partNumber": {
            "type": "string",
            "maxLength": 160
          },
          "x": {
            "type": "number",
            "minimum": 0
          },
          "y": {
            "type": "number",
            "minimum": 0
          },
          "confidence": {
            "enum": [
              "unknown",
              "single-source",
              "independent-sources",
              "licensed-boardview-physical-check"
            ]
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 80
            }
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "source-reviewed",
            "verified",
            "needs-review"
          ]
        },
        "reviewer": {
          "type": "string",
          "maxLength": 160
        },
        "reviewedAt": {
          "type": "string",
          "format": "date"
        },
        "evidenceSummary": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  }
}
